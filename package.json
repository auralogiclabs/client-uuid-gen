{
  "name": "@auralogiclabs/client-uuid-gen",
  "version": "1.0.0",
  "description": "A robust device UUID generator with enhanced fingerprinting parameters.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm,iife --dts --clean --global-name ClientUUIDGen",
    "test": "vitest run",
    "lint": "eslint src/**",
    "format": "prettier --write src/**"
  },
  "keywords": [
    "uuid",
    "device-fingerprint",
    "unique-id",
    "client-id",
    "browser-fingerprint"
  ],
  "author": "Amartya Mondal <amartya@auralogiclabs.com>",
  "license": "MIT",
  "dependencies": {
    "crypto-js": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/crypto-js": "^4.2.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "happy-dom": "^20.0.11",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.0.0"
  }
}
